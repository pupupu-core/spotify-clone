# Copy example env file before first run:
# cp .env.example .env

JAMENDO_API_KEY='JAMENDO_API_KEY'

POSTGRES_USER=pupufy_app
POSTGRES_PASSWORD=postgres
POSTGRES_DB=pupufy
DB_PORT=5432

# Used by Docker containers inside the compose network
DATABASE_URL="postgresql://pupufy_app:postgres@localhost:5432/pupufy"

# Host-side Prisma Studio uses an override from package.json:
# postgresql://pupufy_app:postgres@localhost:5432/pupufy
