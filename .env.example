# Copy example env file before first run:
# cp .env.example .env

# Provider API
JAMENDO_API_KEY='JAMENDO_API_KEY'
JAMENDO_API_CLIENT_ID='XXXXXXXXX'

# DB
POSTGRES_USER=pupufy_app
POSTGRES_PASSWORD=postgres
POSTGRES_DB=pupufy
DB_PORT=5432
DATABASE_URL="postgresql://pupufy_app:postgres@localhost:5432/pupufy"

# AUTH
JWT_SECRET="generate-your-own-with-openssl-rand-base64-32"

# S3 / MinIO storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=eu-central-1
S3_BUCKET=pupufy-uploads
S3_ACCESS_KEY=pupufy_minio_local_admin
S3_SECRET_KEY=pupufy_minio_local_admin_password
S3_FORCE_PATH_STYLE=true

MINIO_ROOT_USER=pupufy_minio_local_admin
MINIO_ROOT_PASSWORD=pupufy_minio_local_admin_password
