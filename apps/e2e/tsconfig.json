{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "outDir": "../../dist/out-tsc",
    "sourceMap": false,
    "module": "commonjs",
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": "./src",
    "paths": {
      "#/pages/*": ["./pages/*"],
      "#/shared/*": ["./shared/*"],

      "@streaming-service/utils": ["../../../../packages/shared/utils/src/index.ts"],
      "@streaming-service/config": ["../../../../packages/shared/config/src/index.ts"],
      "@streaming-service/model": ["../../../../packages/shared/model/src/index.ts"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.js",
    "playwright.config.ts",
    "src/**/*.spec.ts",
    "src/**/*.spec.js",
    "src/**/*.test.ts",
    "src/**/*.test.js",
    "src/**/*.d.ts"
  ]
}
