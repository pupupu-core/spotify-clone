{
  "name": "web",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "ppf",
  "sourceRoot": "apps/web/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/web",
        "browser": "apps/web/src/main.ts",
        "polyfills": ["zone.js"],
        "tsConfig": "apps/web/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/web/public"
          }
        ],
        "styles": ["apps/web/src/styles.scss"],
        "stylePreprocessorOptions": {
          "includePaths": ["apps/web"]
        }
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all",
          "fileReplacements": [
            {
              "replace": "apps/web/src/environments/environment.ts",
              "with": "apps/web/src/environments/environment.prod.ts"
            }
          ]
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "dependsOn": [
        {
          "projects": ["api"],
          "target": "serve"
        }
      ],
      "options": {
        "proxyConfig": "apps/web/proxy.conf.json"
      },
      "configurations": {
        "production": {
          "buildTarget": "web:build:production"
        },
        "development": {
          "buildTarget": "web:build:development"
        }
      },
      "defaultConfiguration": "development"
    },
    "serve-standalone": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "options": {
        "proxyConfig": "apps/web/proxy.conf.json"
      },
      "configurations": {
        "production": {
          "buildTarget": "web:build:production"
        },
        "development": {
          "buildTarget": "web:build:development"
        }
      },
      "defaultConfiguration": "development"
    },
    "stylelint": {
      "executor": "nx:run-commands",
      "outputs": [],
      "options": {
        "command": "stylelint \"apps/web/src/**/*.{scss,css}\" \"apps/web/src/**/*.component.ts\" --allow-empty-input"
      }
    },
    "stylelint-fix": {
      "executor": "nx:run-commands",
      "outputs": [],
      "options": {
        "command": "stylelint \"apps/web/src/**/*.{scss,css}\" \"apps/web/src/**/*.component.ts\" --fix --allow-empty-input"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "outputs": [],
      "options": {
        "command": "tsc -p apps/web/tsconfig.json --noEmit"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "options": {
        "runner": "vitest",
        "watch": false,
        "coverage": false
      },
      "configurations": {
        "coverage": {
          "coverage": true,
          "coverageInclude": ["apps/web/src/app/**/*.ts"],
          "coverageExclude": [
            "apps/web/src/app/**/*.spec.ts",
            "apps/web/src/app/**/*.model.ts",
            "apps/web/src/app/**/index.ts"
          ],
          "coverageReporters": ["text-summary", "html", "lcov"],
          "coverageThresholds": {
            "statements": 50,
            "branches": 50,
            "functions": 30,
            "lines": 50
          }
        }
      }
    },
    "test-watch": {
      "executor": "@angular/build:unit-test",
      "options": {
        "runner": "vitest",
        "watch": true,
        "coverage": false
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "web:build",
        "port": 4200,
        "staticFilePath": "dist/apps/web/browser",
        "spa": true
      }
    }
  }
}
