{
  "name": "angular-nest-monorepo-starter",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "serve:backend": "nx run api:serve",
    "serve:frontend": "nx run web:serve-standalone",
    "show:backend": "nx show project api",
    "show:frontend": "nx show project web",
    "dev": "nx run web:serve",
    "lint": "pnpm run lint:check",
    "lint:check": "nx run-many -t lint",
    "lint:fix": "nx run-many -t lint -- --fix",
    "lint:web:check": "nx run web:lint",
    "lint:web:fix": "nx run web:lint -- --fix",
    "lint:api:check": "nx run api:lint",
    "lint:api:fix": "nx run api:lint -- --fix",
    "lint:affected": "nx affected -t lint",
    "lint:staged": "lint-staged",
    "typecheck:web": "nx run web:typecheck",
    "typecheck:api": "nx run api:typecheck",
    "typecheck:packages": "tsc -p packages/shared/model/tsconfig.json --noEmit && tsc -p packages/shared/utils/tsconfig.json --noEmit && tsc -p packages/shared/config/tsconfig.json --noEmit",
    "typecheck": "pnpm typecheck:web && pnpm typecheck:api && pnpm typecheck:packages",
    "typecheck:affected": "nx affected -t typecheck",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check:precommit": "pnpm run lint:staged",
    "check:prepush": "pnpm run lint:affected && pnpm run stylelint:affected && pnpm run typecheck:affected",
    "stylelint:web": "nx run web:stylelint",
    "stylelint:web:fix": "nx run web:stylelint-fix",
    "stylelint:affected": "nx affected -t stylelint",
    "stylelint:affected:fix": "nx affected -t stylelint-fix",
    "commitlint": "commitlint --edit",
    "prepare": "husky",
    "build": "nx run-many -t build",
    "build:backend": "nx run api:build",
    "build:frontend": "nx run web:build",
    "build:affected": "nx affected -t build",
    "reset": "pnpm nx reset"
  },
  "private": true,
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "~2.1.2",
    "@analogjs/vitest-angular": "~2.1.2",
    "@angular-devkit/core": "~21.2.0",
    "@angular-devkit/schematics": "~21.2.0",
    "@angular/build": "~21.2.0",
    "@angular/cli": "~21.2.0",
    "@angular/compiler-cli": "~21.2.0",
    "@angular/language-service": "~21.2.0",
    "@commitlint/cli": "^21.0.0",
    "@commitlint/config-angular": "^21.0.0",
    "@eslint/js": "^9.8.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@nx/angular": "22.7.1",
    "@nx/devkit": "22.7.1",
    "@nx/eslint": "22.7.1",
    "@nx/eslint-plugin": "22.7.1",
    "@nx/js": "22.7.1",
    "@nx/nest": "22.7.1",
    "@nx/node": "22.7.1",
    "@nx/playwright": "22.7.1",
    "@nx/vite": "22.7.1",
    "@nx/vitest": "22.7.1",
    "@nx/web": "22.7.1",
    "@nx/webpack": "22.7.1",
    "@nx/workspace": "22.7.1",
    "@oxc-project/runtime": "^0.115.0",
    "@playwright/test": "^1.36.0",
    "@schematics/angular": "~21.2.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@swc-node/register": "~1.11.1",
    "@swc/core": "~1.15.5",
    "@swc/helpers": "~0.5.18",
    "@types/node": "20.19.9",
    "@typescript-eslint/utils": "^8.40.0",
    "@vitest/coverage-v8": "~4.1.0",
    "@vitest/ui": "~4.1.0",
    "angular-eslint": "^21.2.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-playwright": "^1.6.2",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "jsdom": "^27.1.0",
    "lint-staged": "^17.0.4",
    "nx": "22.7.1",
    "postcss-angular": "^2.0.0",
    "prettier": "~3.6.2",
    "stylelint": "^17.11.0",
    "stylelint-config-clean-order": "^8.0.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "tslib": "^2.3.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.40.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.8",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "@angular/common": "~21.2.0",
    "@angular/compiler": "~21.2.0",
    "@angular/core": "~21.2.0",
    "@angular/forms": "~21.2.0",
    "@angular/platform-browser": "~21.2.0",
    "@angular/router": "~21.2.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "axios": "^1.6.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.0",
    "zone.js": "^0.16.2"
  }
}
