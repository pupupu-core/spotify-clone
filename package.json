{
  "name": "streaming-service",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "serve:backend": "nx run api:serve",
    "serve:frontend": "nx run web:serve-standalone",
    "show:backend": "nx show project api",
    "show:frontend": "nx show project web",
    "dev": "nx run web:serve",
    "lint": "pnpm run lint:check",
    "lint:check": "nx run-many -t lint",
    "lint:fix": "nx run-many -t lint -- --fix",
    "lint:web:check": "nx run web:lint",
    "lint:web:fix": "nx run web:lint -- --fix",
    "lint:api:check": "nx run api:lint",
    "lint:api:fix": "nx run api:lint -- --fix",
    "lint:affected": "nx affected -t lint",
    "lint:staged": "lint-staged --allow-empty",
    "typecheck:web": "nx run web:typecheck",
    "typecheck:api": "nx run api:typecheck",
    "typecheck:packages": "tsc -p packages/shared/model/tsconfig.json --noEmit && tsc -p packages/shared/utils/tsconfig.json --noEmit && tsc -p packages/shared/config/tsconfig.json --noEmit",
    "typecheck": "pnpm typecheck:web && pnpm typecheck:api && pnpm typecheck:packages",
    "typecheck:affected": "nx affected -t typecheck",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check:precommit": "pnpm run lint:staged",
    "check:prepush": "pnpm run lint:affected && pnpm run stylelint:affected && pnpm run typecheck:affected && pnpm run format:check",
    "stylelint:web": "nx run web:stylelint",
    "stylelint:web:fix": "nx run web:stylelint-fix",
    "stylelint:affected": "nx affected -t stylelint",
    "stylelint:affected:fix": "nx affected -t stylelint-fix",
    "commitlint": "commitlint --edit",
    "prepare": "husky",
    "build": "nx run-many -t build",
    "build:backend": "nx run api:build",
    "build:frontend": "nx run web:build",
    "build:affected": "nx affected -t build",
    "reset": "pnpm nx reset",
    "deps": "pnpm install --frozen-lockfile",
    "db:validate": "prisma validate",
    "db:format": "prisma format",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:up": "docker compose up -d",
    "dev:up": "docker compose up -d && pnpm dev"
  },
  "private": true,
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "~2.1.3",
    "@analogjs/vitest-angular": "~2.1.3",
    "@angular-devkit/core": "~21.2.10",
    "@angular-devkit/schematics": "~21.2.10",
    "@angular/build": "~21.2.10",
    "@angular/cli": "~21.2.10",
    "@angular/compiler-cli": "~21.2.13",
    "@angular/language-service": "~21.2.13",
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-angular": "^20.5.3",
    "@eslint/js": "^9.39.4",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.19",
    "@nx/angular": "22.7.1",
    "@nx/devkit": "22.7.1",
    "@nx/eslint": "22.7.1",
    "@nx/eslint-plugin": "22.7.1",
    "@nx/js": "22.7.1",
    "@nx/nest": "22.7.1",
    "@nx/node": "22.7.1",
    "@nx/playwright": "22.7.1",
    "@nx/vite": "22.7.1",
    "@nx/vitest": "22.7.1",
    "@nx/web": "22.7.1",
    "@nx/webpack": "22.7.1",
    "@nx/workspace": "22.7.1",
    "@oxc-project/runtime": "^0.129.0",
    "@playwright/test": "^1.59.1",
    "@schematics/angular": "~21.2.10",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@swc-node/register": "~1.11.1",
    "@swc/core": "~1.15.33",
    "@swc/helpers": "~0.5.21",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "20.19.9",
    "@typescript-eslint/utils": "^8.59.2",
    "@vitest/coverage-v8": "~4.1.5",
    "@vitest/ui": "~4.1.5",
    "angular-eslint": "^21.3.1",
    "concurrently": "^9.2.1",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-playwright": "^1.8.3",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "jsdom": "^27.4.0",
    "lint-staged": "^17.0.2",
    "nx": "22.7.1",
    "postcss-angular": "^2.0.0",
    "prettier": "~3.6.2",
    "prisma": "^7.8.0",
    "stylelint": "^17.11.0",
    "stylelint-config-clean-order": "^8.0.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "tslib": "^2.8.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.10",
    "vitest": "^4.1.5",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "@angular/animations": "~21.2.13",
    "@angular/cdk": "~21.2.11",
    "@angular/common": "~21.2.13",
    "@angular/compiler": "~21.2.13",
    "@angular/core": "~21.2.13",
    "@angular/forms": "~21.2.13",
    "@angular/material": "~21.2.11",
    "@angular/platform-browser": "~21.2.13",
    "@angular/router": "~21.2.13",
    "@jsverse/transloco": "^8.3.0",
    "@nestjs/common": "^11.1.19",
    "@nestjs/core": "^11.1.19",
    "@nestjs/platform-express": "^11.1.19",
    "@nestjs/swagger": "^11.4.2",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "axios": "^1.16.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "pg": "^8.20.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zone.js": "^0.16.2"
  }
}
